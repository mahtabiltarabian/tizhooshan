# For docker-compose.prod.yml. Copy to .env.production and fill in; never commit it.
POSTGRES_PASSWORD=change-me-long-random
OTP_SECRET=change-me-long-random
CORS_ORIGINS=https://app.example.ir
SMS_SENDER=dev
# SMS_API_KEY=
# Requests per minute from one address (a whole school may share one); sign-in has a smaller limit.
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=30
