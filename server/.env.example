# Copy to .env. Never commit .env.
DATABASE_URL="postgresql://tizhooshan:tizhooshan@localhost:5434/tizhooshan?schema=public"
# Used by `npm test` (e2e tests wipe this database).
TEST_DATABASE_URL="postgresql://tizhooshan:tizhooshan@localhost:5434/tizhooshan_test?schema=public"
PORT=3200
# Comma-separated app origins allowed by CORS.
CORS_ORIGINS="http://localhost:3100,http://localhost:3217"
# dev = write codes to the log only. kavenegar = stub of a real Iranian SMS provider (not implemented).
SMS_SENDER=dev
# SMS_API_KEY=
# Secret mixed into OTP code hashes. Set a long random value in production.
OTP_SECRET="change-me-in-production"
# The server's calendar (assignment due dates, "today").
TZ=Asia/Tehran
