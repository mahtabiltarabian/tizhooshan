{
  "name": "tizhooshan-server",
  "version": "0.1.0",
  "private": true,
  "description": "API server of Tizhooshan (NestJS + Prisma + PostgreSQL). Reuses the app's pure practice code from ../src.",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../src/practice --watch-path=../src/tools --watch-path=../src/generators -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server/src/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/client": "6.19.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "react": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/react": "19.3.0",
    "@types/supertest": "^6.0.2",
    "jest": "29.7.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
